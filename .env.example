# App URL (your Vercel deployment URL, no trailing slash)
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app

# Meta Developer App (Instagram API with Instagram Login)
INSTAGRAM_APP_ID=your_instagram_app_id
INSTAGRAM_APP_SECRET=your_instagram_app_secret
META_WEBHOOK_VERIFY_TOKEN=any_random_secret_string_for_meta_webhook

# Session signing secret (generate any 32+ char random string)
APP_SESSION_SECRET=replace_with_a_long_random_secret_key_32_chars

# Supabase (PostgreSQL)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
